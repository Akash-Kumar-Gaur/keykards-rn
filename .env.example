# Supabase — copy to .env.local (or .env) and fill in.
# These are safe to expose in the client bundle (anon key is public by design;
# real protection comes from Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails allowed to open internal Catalog review
EXPO_PUBLIC_ADMIN_EMAILS=4k45hh@gmail.com

# Edge Function secrets for parse-statement (never ship in the app bundle).
# Prefer OpenAI (same key as workers/catalog-scraper):
#   supabase secrets set OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_PDF_MODEL=gpt-4o
# Optional Anthropic fallback if OPENAI_API_KEY is unset:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Card shares — end-to-end: PAN encrypted on-device under a per-share key.
# The key is embedded in the link fragment (#k=…) and NEVER set as a server secret.
# Optional public origin for share link *path* returned by create-card-share
# (client appends #k= locally for full-number shares):
# SHARE_PUBLIC_BASE_URL=https://inwallet.redevolve.in
# SHARE_DEBUG_REASONS=true  # optional, staging only

# Optional override for share link base in the app (defaults to https://inwallet.redevolve.in)
# EXPO_PUBLIC_SHARE_BASE_URL=https://inwallet.redevolve.in