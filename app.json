{
  "expo": {
    "name": "InWallet",
    "slug": "inwallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inwallet",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A14",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cdde3dcc-ce4a-4e3a-bee3-b01a6d9c4902"
    },
    "ios": {
      "bundleIdentifier": "in.redevolve.inwallet",
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "InWallet uses Face ID to unlock the app and protect your card details.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:inwallet.redevolve.in",
        "applinks:inwallet.redevolve.in"
      ]
    },
    "android": {
      "package": "in.redevolve.inwallet",
      "icon": "./assets/images/android-icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.NFC",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "inwallet.redevolve.in",
              "pathPrefix": "/shared"
            },
            {
              "scheme": "inwallet",
              "host": "shared"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A14",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "InWallet uses Face ID to unlock the app and protect your card details."
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-camera",
        {
          "cameraPermission": "InWallet uses the camera to scan your card number and expiry on this device. Frames are processed locally and never uploaded.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "vision"
        }
      ],
      "expo-updates",
      "./plugins/withAndroidFlagSecure",
      "./plugins/withAndroidScreenshotMode",
      "./plugins/withAndroidNfc",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdde3dcc-ce4a-4e3a-bee3-b01a6d9c4902"
      }
    },
    "owner": "ak45h6017"
  }
}
