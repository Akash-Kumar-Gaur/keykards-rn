# Catalog scraper (Railway) — never commit real secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM — use either OpenAI or Anthropic (or both; auto prefers OpenAI)
LLM_PROVIDER=auto
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Cap LLM cost per scheduled run
MAX_CARDS_PER_RUN=8
# standard-priority cards: re-scrape when last_verified_at older than this
STALE_DAYS=90
# high-priority (fintech / app-first): shorter cycle
STALE_DAYS_HIGH=14
# pending known_cards → failed after N consecutive extraction errors
EXTRACTION_FAIL_THRESHOLD=3
# max listing pages per discovery cron run
MAX_DISCOVERY_SOURCES_PER_RUN=40
FETCH_DELAY_MS=2500
MAX_PROMPT_CHARS=24000
SNIPPET_CHARS=4000

# Set false on tiny Railway instances if Chromium is too heavy
USE_PLAYWRIGHT=true

# For HTTP "run now" (npm run serve)
CRON_SECRET=change-me
PORT=8080
